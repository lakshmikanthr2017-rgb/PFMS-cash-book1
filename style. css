*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{
font-family:Arial, sans-serif;
background:#f2f4f7;
padding:15px;
}

.container{
max-width:1900px;
margin:auto;
background:#fff;
padding:15px;
border-radius:10px;
box-shadow:0 0 10px rgba(0,0,0,0.15);
}

header{
text-align:center;
margin-bottom:20px;
}

header h1{
color:#003366;
margin-bottom:5px;
}

header h3{
color:#555;
}

.school-section{
display:flex;
gap:10px;
flex-wrap:wrap;
margin-bottom:20px;
}

.school-section input{
padding:8px;
border:1px solid #ccc;
border-radius:5px;
min-width:250px;
}

.school-section button{
padding:8px 15px;
background:#0066cc;
color:white;
border:none;
border-radius:5px;
cursor:pointer;
}

.entry-section{
background:#f8f9fa;
padding:15px;
border-radius:8px;
margin-bottom:20px;
}

.entry-section h2,
.entry-section h3{
margin-bottom:10px;
margin-top:10px;
}

.form-row{
display:flex;
gap:10px;
flex-wrap:wrap;
margin-bottom:15px;
}

.form-row input{
padding:8px;
border:1px solid #ccc;
border-radius:5px;
}

.grant-grid{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:10px;
margin-bottom:15px;
}

.grant-grid input{
padding:8px;
border:1px solid #ccc;
border-radius:5px;
width:100%;
}

.save-btn{
background:green;
color:white;
padding:10px 20px;
border:none;
border-radius:5px;
cursor:pointer;
font-weight:bold;
}

.ledger-section{
overflow-x:auto;
}

table{
width:100%;
border-collapse:collapse;
min-width:1800px;
}

table th,
table td{
border:1px solid #000;
padding:5px;
font-size:12px;
text-align:center;
}

table th{
background:#d9e2f3;
}

.divider{
background:#ffffff;
border:none !important;
width:10px;
}

.receipt-row{
background:#eaf7ea;
}

.payment-row{
background:#fdeaea;
}

